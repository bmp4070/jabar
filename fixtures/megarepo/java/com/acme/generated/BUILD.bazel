load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# A source file that exists only under bazel-out. jabar has to resolve it
# through the build graph; walking the source tree will never find it.
genrule(
    name = "build_version_src",
    outs = ["BuildVersion.java"],
    cmd = """cat > $@ <<'EOJ'
package com.acme.generated;

/** Generated by //java/com/acme/generated:build_version_src. Do not edit. */
public final class BuildVersion {

  public static final String VERSION = "0.1.0-fixture";

  private BuildVersion() {}

  public static String describe() {
    return "acme-megarepo " + VERSION;
  }
}
EOJ""",
)

java_library(
    name = "generated",
    srcs = [":build_version_src"],
)
